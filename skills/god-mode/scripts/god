#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cmd="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  setup)
    exec "$SCRIPT_DIR/setup.sh" "$@"
    ;;
  status)
    exec "$SCRIPT_DIR/commands/status.sh" "$@"
    ;;
  sync)
    exec "$SCRIPT_DIR/commands/sync.sh" "$@"
    ;;
  projects)
    exec "$SCRIPT_DIR/commands/projects.sh" "$@"
    ;;
  agents)
    exec "$SCRIPT_DIR/commands/agents.sh" "$@"
    ;;
  ""|-h|--help|help)
    cat <<'EOF'
Usage: god <command> [args]

Commands:
  setup                 First-run setup
  status [project]      Show overview/status
  sync [project]        Sync repo data
  projects ...          Manage projects
  agents ...            Agent analysis tools

Examples:
  god setup
  god status
  god projects add github:user/repo
EOF
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    exit 1
    ;;
esac
